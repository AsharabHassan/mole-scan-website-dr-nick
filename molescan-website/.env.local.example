NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=https://molescan.uk

# Brevo: form submissions (Request Demo + Contact). Treat the API key as a secret.
# API key: Brevo > Settings > SMTP & API > API keys.
BREVO_API_KEY=
# Sender for all emails. Must be a verified sender or on a verified domain in Brevo.
BREVO_SENDER_EMAIL=hello@molescan.uk
BREVO_SENDER_NAME=MoleScan
# Team inbox(es) that get a notification for every submission (comma-separated).
BREVO_NOTIFY_EMAILS=hello@molescan.uk
# Brevo contact list IDs (numbers, from Contacts > Lists) for each form.
BREVO_DEMO_LIST_ID=
BREVO_CONTACT_LIST_ID=
